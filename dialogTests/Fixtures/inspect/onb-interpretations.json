            }
          ]
        }
      ],
      "stepOverlay": {
        "title": "What the fixture can see",
        "subtitle": "Fixture overlay body for the receipt's quiet door.",
        "content": [
          {
            "type": "checklist",
            "checklist": [
              {
                "text": "Fixture fact one",
